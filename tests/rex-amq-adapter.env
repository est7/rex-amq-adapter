# Profile for rex-amq-adapter's v:2 CLI, read by the agent-cli-design skill's
# unmodified verify-cli-contract.sh:
#
#   bash verify-cli-contract.sh --profile tests/rex-amq-adapter.env <binary>
#
# Every call runs outside Rex: the adapter's state, HOME, and XDG dirs live
# under $GATE_WORK (the script removes it), REX_SERVER names a socket that
# does not exist, and the caller's Rex pane, harness sessions, and
# unattended marker are blanked, as the Go tests' isolate() does. No gate
# reaches a live Rex server, amq root, or harness config.
GATE_STATE="$GATE_WORK/state"
GATE_HOME="$GATE_WORK/home"
GATE_DIR="$GATE_WORK/dir"
mkdir -p "$GATE_HOME" "$GATE_DIR"
RUN_ENV=(
  "REX_AMQ_ADAPTER_HOME=$GATE_STATE" "HOME=$GATE_HOME"
  "XDG_CONFIG_HOME=$GATE_HOME/.config" "XDG_STATE_HOME=$GATE_HOME/.local/state" "XDG_CACHE_HOME=$GATE_HOME/.cache"
  "REX_SERVER=unix://$GATE_WORK/no-rex.sock"
  "REX_BLOCK=" "REX_SESSION=" "CLAUDE_CODE_SESSION_ID=" "CODEX_THREAD_ID=" "PI_SESSION_ID=" "ANTIGRAVITY_CONVERSATION_ID="
  "ME_UNATTENDED=" "ME_HUB=" "CLAUDE_CONFIG_DIR=" "CODEX_HOME=" "PI_CODING_AGENT_DIR="
)
TIMEOUT=10
S=session:01a1eac4-f222-7d79-9291-9a8a86d39ec3
B=block:01a1eac4-f234-7985-8bef-2ea92c753265

MISSING_ARGS=("agent await" "agent retire" "agent summon" "mail send" "mail reply" "mail read" "mail thread" "mail trace"
  "mail dlq read" "epic open" "epic close" "epic revive" "epic messages" "epic handback" "epic artifacts" "epic materialize" "epic link"
  "epic unlink" "hub add" "hub remove" "hub notify" "trust check" "trust grant" "trust root add" "trust root remove")

JSON_CMDS=("schema" "schema errors" "schema agent summon" "version" "--help" "agent --help" "agent retire --help" "trust root --help"
  "skill list" "skill show peers" "crew list" "crew show pair" "hub list" "trust root list" "agent collect --dry-run"
  "agent list" "nonesuch" "who" "mail dlq purge" "epic close $S" "skill show nope" "agent retire ../x" "agent list -y")

PRETTY_FLAG=--text
PRETTY_ERR_CMDS=("nonesuch" "who" "skill show nope" "agent retire ../x" "mail dlq purge" "crew show no-such-crew" "epic close $S")

ID_CMDS=("agent retire {ID}" "agent await {ID}" "agent list --session {ID}" "agent summon {ID} --subject s --body b"
  "agent join {ID}" "agent join --role {ID}"
  "mail send --to {ID} --subject s --body b" "mail reply --id {ID} --body b" "mail read --id {ID}" "mail thread --id {ID}"
  "mail trace {ID}" "mail list --from {ID}" "mail dlq read --id {ID}" "mail dlq retry --id {ID}"
  "epic open x --cwd $GATE_DIR --asked go --crew {ID}" "epic close {ID} --asked x" "epic revive {ID}" "epic show {ID}" "epic grant {ID}"
  "epic messages --ids {ID}" "epic artifacts {ID}" "epic materialize {ID} --into $GATE_DIR" "epic link {ID}" "epic unlink {ID}"
  "epic list --personal {ID}"
  "hub notify --ref {ID} --event-id e" "hub notify --ref inbox:1 --event-id {ID}" "hub notify --ref inbox:1 --event-id e --personal {ID}"
  "crew show {ID}" "crew show --role {ID}" "skill show {ID}" "stream events --session {ID}" "stream panel --session {ID}")

YES_CMDS=("mail send --to claude-02 --subject s --body b" "mail reply --id m-1 --body b" "mail dlq purge --confirm purge"
  "epic close $S --asked x" "epic open x --cwd $GATE_DIR --asked go" "agent retire codex-01" "agent summon reviewer --subject s --body b --asked go"
  "hub notify --ref inbox:1 --event-id e" "trust grant $GATE_DIR" "trust root remove $GATE_DIR" "install setup" "install remove")

GUARD_ENV=(ME_UNATTENDED=1)
GUARD_EXIT=6
GUARD_CMDS=("trust grant $GATE_DIR" "trust grant $GATE_DIR --dry-run" "trust root add $GATE_DIR" "trust root remove $GATE_DIR"
  "hub add $GATE_DIR" "hub remove $GATE_DIR" "install setup" "install setup --dry-run" "install remove" "stream panel"
  "epic list" "epic show $S" "epic revive $S" "epic revive $S --dry-run")

NOCONFIG_CMDS=("schema" "schema errors" "schema epic open" "version" "skill list")

CLEAN_DIRS=("$GATE_STATE" "$GATE_HOME" "$GATE_DIR")
